# MongoDB connection string
# Local:      mongodb://localhost:27017/tripgenie
# Atlas free: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tripgenie
MONGODB_URI=mongodb://localhost:27017/tripgenie

# ── LLM Configuration ──────────────────────────────────────────────────────
# Option 1 (Recommended — free cloud): https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2 (Local only): Ollama — only used when GROQ_API_KEY is not set
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── CORS (production) ──────────────────────────────────────────────────────
# Set this to your Vercel frontend URL after deploying
FRONTEND_URL=https://your-app.vercel.app
