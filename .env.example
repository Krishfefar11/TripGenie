# MongoDB connection string
# Local:      mongodb://localhost:27017/tripgenie
# Atlas free: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tripgenie
MONGODB_URI=mongodb://localhost:27017/tripgenie

# ── LLM Configuration ──────────────────────────────────────────────────────
# Tried in order: Groq -> Gemini -> local Ollama -> mock fallback.
# Set at least one cloud key (Groq and/or Gemini) for production/deployed use —
# Ollama only works when you're running it locally, so it's not a real
# fallback on a deployed server like Render.

# Option 1 (fastest): https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option 2 (recommended production fallback — free, no credit card,
# 1,500 requests/day): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Option 3 (local dev only): Ollama — only used when both keys above are absent/failing
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── CORS (production) ──────────────────────────────────────────────────────
# Set this to your Vercel frontend URL after deploying
FRONTEND_URL=https://your-app.vercel.app
